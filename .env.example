# URL du serveur Spotlook (sans slash final)
SERVER_URL=http://localhost:3000

# Token d'écran généré lors de l'enregistrement (POST /api/player/register)
SCREEN_TOKEN=

# Dossier de cache local
CACHE_DIR=/cache/spotlook

# Plateforme : rpi | windows | auto (détection automatique)
PLATFORM=auto

# Chemin vers Chromium / Chrome
CHROMIUM_PATH=

# Chemin vers VLC
VLC_PATH=

# Niveau de logs : info | debug | warn | error
LOG_LEVEL=info

# Découpage de player.log : taille max en Mo avant archivage (player.log.1…),
# et nombre d'archives conservées (occupation max = (1 + archives) x taille)
LOG_MAX_MO=10
LOG_NB_ARCHIVES=5

# Intervalle de reconnexion au serveur en cas de panne (en secondes)
RECONNECT_INTERVAL_S=60

# Apparence de l'affichage texte
TEXT_BG_COLOR=\#000000
TEXT_COLOR=\#ffffff
TEXT_FONT_SIZE_PX=64
